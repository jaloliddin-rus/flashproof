<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:FlashProof"
             xmlns:vm="using:FlashProof.ViewModels"
             x:Class="FlashProof.Views.InspectView"
             x:DataType="vm:InspectViewModel">
  <ScrollViewer>
    <StackPanel Classes="page">
      <StackPanel Spacing="2">
        <TextBlock Classes="muted" Text="{x:Static app:Text.InspectTitle}" />
        <TextBlock Classes="h1" Text="{Binding Name}" />
        <TextBlock Text="{Binding Capacity}" IsVisible="{Binding MediaPresent}" />
        <TextBlock Classes="muted" Text="{x:Static app:Text.UnitsExplained}" IsVisible="{Binding MediaPresent}" FontSize="13" />
      </StackPanel>

      <!-- The summary: never a health pass (design §2) -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <StackPanel Spacing="6" IsVisible="{Binding NoProblemsFound}">
            <TextBlock Classes="h2 good"><Run Text="✓ " /><Run Text="{x:Static app:Text.NoProblemsFound}" /></TextBlock>
            <TextBlock Text="{x:Static app:Text.NotAHealthPass}" />
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding !NoProblemsFound}">
            <TextBlock Classes="h2 bad"><Run Text="! " /><Run Text="{x:Static app:Text.ProblemsFound}" /></TextBlock>
            <ItemsControl ItemsSource="{Binding Problems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding StringFormat='• {0}'}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusAdvice}" IsVisible="{Binding StatusAdvice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <Border Classes="notice" IsVisible="{Binding ShowHoldsFilesAdvice}">
        <TextBlock Text="{x:Static app:Text.HoldsFilesAdvice}" />
      </Border>

      <StackPanel Spacing="8" IsVisible="{Binding MediaPresent}">
        <TextBlock Classes="h2" Text="{x:Static app:Text.VolumesLabel}" />
        <ItemsControl ItemsSource="{Binding Volumes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InspectViewModel+VolumeRow">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Margin="12,0,0,0" Content="{x:Static app:Text.ReadAllFiles}" Command="{Binding ReadCommand}"
                        IsVisible="{Binding HasFileSystem}" IsEnabled="{Binding CanRead}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted" FontSize="13" Text="{x:Static app:Text.ReadAllFilesHint}" />
        <StackPanel Spacing="8" IsVisible="{Binding IsReading}">
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding ReadFraction}" Height="8" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ReadProgress}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{x:Static app:Text.Stop}" Command="{Binding StopCommand}" />
          </Grid>
        </StackPanel>
        <TextBlock Text="{Binding ReadMessage}" IsVisible="{Binding ReadMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <ItemsControl ItemsSource="{Binding UnreadableFiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="bad" Text="{Binding StringFormat='• {0}'}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="h2" Text="{x:Static app:Text.WriteProtectionLabel}" />
        <TextBlock Text="{Binding WriteProtection}" />

        <TextBlock Classes="h2" Text="{x:Static app:Text.EventsLabel}" IsVisible="{Binding EventsRead}" />
        <TextBlock Text="{x:Static app:Text.NoEvents}" IsVisible="{Binding NoEvents}" />
        <ItemsControl ItemsSource="{Binding Events}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InspectViewModel+EventRow">
              <StackPanel>
                <TextBlock Text="{Binding Title}" Classes.bad="{Binding IsError}" />
                <TextBlock Classes="muted" FontSize="13" Text="{Binding Caveat}" IsVisible="{Binding HasCaveat}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Export (design §9): serials hidden unless asked for -->
      <StackPanel Spacing="8">
        <CheckBox IsChecked="{Binding IncludeSerials}">
          <TextBlock Text="{x:Static app:Text.IncludeSerials}" />
        </CheckBox>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{x:Static app:Text.CopyReport}" Command="{Binding CopyCommand}" />
          <Button Content="{x:Static app:Text.SaveReport}" Command="{Binding SaveCommand}" />
          <TextBlock Classes="muted" Text="{Binding ExportMessage}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="{x:Static app:Text.BackToDrives}" Command="{Binding BackCommand}" />
        <Button Classes="accent" Content="{x:Static app:Text.FullTest}" Command="{Binding TestCommand}" IsVisible="{Binding CanTest}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
