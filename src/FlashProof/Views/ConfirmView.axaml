<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:FlashProof"
             xmlns:vm="using:FlashProof.ViewModels"
             x:Class="FlashProof.Views.ConfirmView"
             x:DataType="vm:ConfirmViewModel">
  <ScrollViewer>
    <StackPanel Classes="page">
      <TextBlock Classes="h1" Text="{x:Static app:Text.ConfirmTitle}" />
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding DeviceLine}" />
          <TextBlock Text="{Binding WhatIsWritten}" />
          <TextBlock Text="{Binding Scope}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding TimeRange}" />
        </StackPanel>
      </Border>
      <Border Classes="notice">
        <TextBlock FontWeight="SemiBold"><Run Text="! " /><Run Text="{x:Static app:Text.FakeDamageWarning}" /></TextBlock>
      </Border>
      <TextBlock Text="{x:Static app:Text.StayPluggedIn}" />
      <CheckBox IsChecked="{Binding BackedUp}">
        <TextBlock Text="{x:Static app:Text.ConfirmBackedUp}" />
      </CheckBox>
      <StackPanel Spacing="2">
        <CheckBox IsChecked="{Binding Replug}">
          <TextBlock Text="{x:Static app:Text.ConfirmReplug}" />
        </CheckBox>
        <TextBlock Classes="muted" FontSize="13" Margin="28,0,0,0" TextWrapping="Wrap" Text="{x:Static app:Text.ConfirmReplugHint}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="{x:Static app:Text.Back}" Command="{Binding BackCommand}" />
        <Button Classes="accent" Content="{x:Static app:Text.StartTest}" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
